# GitHub repository URL (HTTPS)
REPO_URL=https://github.com/user/repo

# Branch to deploy (default: main)
BRANCH=main

# GitHub token for private repos (optional)
# Fine-grained personal access token with Contents: Read-only access to your repo
GITHUB_TOKEN=

# Webhook secret for GitHub signature verification (required)
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=your-webhook-secret-here

# Port for webhook server (default: 9000)
WEBHOOK_PORT=9000

# Node environment (default: production)
NODE_ENV=production

# Any other environment variables your app needs
# APP_SETTING=value
